{
  "name": "@insta/ui",
  "version": "2.0.1",
  "description": "Reusable UI library for Insta apps.",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "prepack": "pnpm run build"
  },
  "devDependencies": {
    "typescript": "catalog:"
  }
}
