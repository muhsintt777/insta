{
  "name": "insta-social",
  "description": "A social media application built with React, Redux Toolkit, React Router, and Material-UI.",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel --filter @insta/shell --filter @insta/friends --filter @insta/chat --filter @insta/notifications dev",
    "stop": "pnpm --parallel --filter @insta/shell --filter @insta/friends --filter @insta/chat --filter @insta/notifications stop",
    "shell:build": "pnpm --filter @insta/shell build",
    "shell:test:watch": "pnpm --filter @insta/shell test:watch",
    "friends:dev": "pnpm --filter @insta/friends dev",
    "friends:build": "pnpm --filter @insta/friends build",
    "chat:dev": "pnpm --filter @insta/chat dev",
    "chat:build": "pnpm --filter @insta/chat build",
    "notifications:dev": "pnpm --filter @insta/notifications dev",
    "notifications:build": "pnpm --filter @insta/notifications build",
    "ui:build": "pnpm --filter @insta/ui build",
    "ui:typecheck": "pnpm --filter @insta/ui typecheck",
    "ui:test:watch": "pnpm --filter @insta/ui test:watch",
    "ui:test:coverage": "pnpm --filter @insta/ui test:coverage",
    "ui:test": "pnpm --filter @insta/ui test"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "eslint-plugin-react-refresh": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22"
  }
}
