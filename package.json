{
  "name": "insta-social",
  "description": "A social media application built with React, Redux Toolkit, React Router, and Material-UI.",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel --filter @insta/shell --filter @insta/friends dev",
    "stop": "pnpm --parallel --filter @insta/shell --filter @insta/friends stop",
    "dev:friends": "pnpm --filter @insta/friends dev",
    "build:shell": "pnpm --filter @insta/shell build",
    "build:friends": "pnpm --filter @insta/friends build",
    "build:pack:ui": "pnpm --filter @insta/ui build",
    "lint": "pnpm -r lint",
    "format": "pnpm -r format",
    "test": "pnpm -r test",
    "test:watch": "pnpm --filter @insta/shell test:watch",
    "test:coverage": "pnpm -r test:coverage"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "eslint-plugin-react-refresh": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22"
  }
}
