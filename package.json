{
  "name": "insta-social",
  "description": "A social media application built with React, Redux Toolkit, React Router, and Material-UI.",
  "private": true,
  "scripts": {
    "dev": "yarn workspace @insta/shell dev",
    "dev:prod": "yarn workspace @insta/shell dev:prod",
    "build:dev": "yarn workspace @insta/shell build:dev",
    "build:prod": "yarn workspace @insta/shell build:prod",
    "lint": "yarn workspace @insta/shell lint",
    "preview": "yarn workspace @insta/shell preview",
    "format": "yarn workspace @insta/shell format",
    "test": "yarn workspace @insta/shell test",
    "test:watch": "yarn workspace @insta/shell test:watch",
    "test:coverage": "yarn workspace @insta/shell test:coverage"
  },
  "workspaces": [
    "apps/*"
  ],
  "packageManager": "yarn@1.22.22",
  "resolutions": {
    "get-intrinsic": "1.2.4"
  }
}
