{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": "./src",
    "paths": {
      "features/*": ["./features/*"],
      "app/*": ["./app/*"],
      "remotes": ["./remotes/index.ts"],
      "remotes/*": ["./remotes/*"],
      "@insta/contracts": ["../../../packages/contracts/src/index.ts"],
      "@insta/utils": ["../../../packages/utils/src/index.ts"],
      "@insta/utils/*": ["../../../packages/utils/src/*"],
      "@insta/http": ["../../../packages/http/src/index.ts"],
      "test": ["../../../packages/test-utils/src/test"],
      "test/*": ["../../../packages/test-utils/src/test/*"]
    }
  },
  "include": ["src"],
  "exclude": ["src/**/__test__/**"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
